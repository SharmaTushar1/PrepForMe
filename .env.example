# Copy to .env.local and fill in from your Supabase project
# (Settings -> API, and Settings -> API Keys). Both values are safe to ship in
# the browser; row level security is what protects the data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Which AI provider the app talks to. "mock" runs entirely in the browser and
# never calls a model; "edge" invokes the Supabase Edge Functions (analyze,
# tailor, prep chat, …). Those functions then hit *your* Anthropic key, a local
# Ollama bridge, or Anthropic — see README "Running AI locally". Leave
# unset for labelled samples with no model.
VITE_AI_PROVIDER=mock

# The LLM key is deliberately absent: it belongs to a Supabase Edge Function,
# never to the client bundle.
