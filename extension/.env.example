# Copy to .env.local and fill in with the SAME values as the main app's
# .env.local (Supabase Settings -> API). Both are safe to ship in the
# extension bundle; row level security is what protects the data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Where the PrepFor.Me web app runs — the extension's session bridge only
# reads the Supabase session from tabs at this origin. Use
# http://localhost:5173 for local dev, https://prep-for-me.vercel.app in
# production. Comma-separate more than one if you need both at once.
VITE_APP_ORIGINS=http://localhost:5173,https://prep-for-me.vercel.app

# Base URL for the /api/render-resume-pdf endpoint used to attach a tailored
# resume file to Greenhouse's file input. Same app, so same origin as above
# in most setups.
VITE_API_BASE=https://prep-for-me.vercel.app
