# Copy to supabase/.env.ollama (gitignored) and fill in.
#
#   deno run --allow-net --allow-env supabase/functions/_stub/ollama-bridge.ts
#   supabase functions serve --env-file supabase/.env.ollama
#
# ANTHROPIC_API_KEY is a placeholder: the bridge ignores it, but the functions
# refuse to start a model call without one. host.docker.internal because the
# function runs inside the CLI container; localhost there is the container, not
# this machine. The bridge runs on the host and talks to Ollama at :11434.
#
# ANTHROPIC_MODEL is the Ollama tag the bridge will request. Prefer 7B–14B
# instruct models for resume analysis — 27B thinking models exceed the local
# Edge Function wall clock (~200s).
#
# Embeddings still go to OpenAI (prep chat / ingest). Leave OPENAI_API_KEY
# empty only if you will not use those surfaces.

ANTHROPIC_API_KEY=not-a-real-key-bridge-ignores-it
ANTHROPIC_BASE_URL=http://host.docker.internal:8788
# Just put whatever model. Like, how I'm using qwen 2.5:7b. Default naming I'm using Anthropic
ANTHROPIC_MODEL=qwen2.5:7b

# This is for RAG. Since, locally you won't have any data, you don't need this if running locally.
OPENAI_API_KEY=
